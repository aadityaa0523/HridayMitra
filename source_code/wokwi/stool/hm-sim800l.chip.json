{
  "name": "SIM800L GSM + family phone (HridayMitra model)",
  "author": "HridayMitra",
  "pins": ["VCC", "GND", "RX", "TX"],
  "display": { "width": 160, "height": 120 },
  "controls": [
    { "id": "familyReply", "label": "Family replies (1 checking, 2 need help, 3 fine)", "type": "range", "min": 0, "max": 3, "step": 1 },
    { "id": "ashaReply", "label": "ASHA replies (1 seen)", "type": "range", "min": 0, "max": 3, "step": 1 },
    { "id": "missedCall", "label": "Family gives a missed call (0/1)", "type": "range", "min": 0, "max": 1, "step": 1 },
    { "id": "networkDown", "label": "Network outage (0/1)", "type": "range", "min": 0, "max": 1, "step": 1 },
    { "id": "batteryMv", "label": "Battery (mV)", "type": "range", "min": 3200, "max": 4200, "step": 50 },
    { "id": "signal", "label": "Signal (0-31)", "type": "range", "min": 0, "max": 31, "step": 1 }
  ]
}
